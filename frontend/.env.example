# =============================================================================
# Frontend environment template - COMMITTED ON PURPOSE, PLACEHOLDERS ONLY.
# Copy to `.env.local` (git-ignored) and adjust for your machine.
# Never commit a real value: `.env` and `.env.*` are git-ignored except this file.
# =============================================================================

# Base URL of the BFF (blueprint §2.5, port 8185).
# Leave EMPTY to use same-origin requests, which is the default path:
#   - dev  : the Vite dev server proxies /bff -> http://localhost:8185 (vite.config.ts)
#   - prod : nginx proxies /bff -> bff:8185 (infra/docker/nginx/default.conf)
# Set it explicitly (e.g. http://localhost:8185) only when the BFF is on another origin,
# and remember to add that origin to the BFF's BFF_ALLOWED_ORIGINS variable.
VITE_BFF_BASE_URL=

# Target of the dev-server proxy. Only used when VITE_BFF_BASE_URL is empty.
VITE_PROXY_TARGET=http://localhost:8185
