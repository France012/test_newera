# =============================================================================
# TK-DE445B — environment contract of the claims platform (AC-12).
# -----------------------------------------------------------------------------
# Copy to .env (git-ignored) and replace every __change_me__ placeholder:
#     cp .env.example .env
#
# RULES
#   1. This file is the ONLY environment file tracked by git and it must never
#      contain a real credential. Every sensitive value is a __change_me__.
#   2. Real secrets are injected at runtime (CI: GitHub OIDC / repository
#      secrets; Kubernetes: Secret objects; local: untracked .env).
# =============================================================================

# --- PostgreSQL (shared instance in dev, one per service in production) ------
POSTGRES_USER=claims
POSTGRES_PASSWORD=__change_me__
POSTGRES_DB=claims

# --- core-app (backend, port 8180) ------------------------------------------
CORE_APP_DB_URL=jdbc:postgresql://localhost:5442/claims
CORE_APP_DB_POOL_SIZE=10

# --- document-service (backend, port 8181) ----------------------------------
DOCUMENT_SERVICE_DB_URL=jdbc:postgresql://localhost:5442/claims
DOCUMENT_SERVICE_DB_POOL_SIZE=10
# Local filesystem content store; inside the container: /var/lib/documents
DOCUMENTS_STORAGE_PATH=./target/storage

# --- bff (backend for frontend, port 8185) ----------------------------------
# Container-to-container values: http://core-app:8180 / http://document-service:8181
CORE_APP_BASE_URL=http://localhost:8180
DOCUMENT_SERVICE_BASE_URL=http://localhost:8181
# Comma-separated browser origins. NEVER use "*": credentials are enabled.
BFF_ALLOWED_ORIGINS=http://localhost:5199
BFF_CONNECT_TIMEOUT_MS=2000
BFF_READ_TIMEOUT_MS=5000

# --- frontend (React + Vite, dev 5199 / preview 5198 / container 8188) ------
# Empty means same-origin: the dev server proxies /bff to VITE_PROXY_TARGET.
VITE_BFF_BASE_URL=
VITE_PROXY_TARGET=http://localhost:8185
